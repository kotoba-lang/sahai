;; The .cljk sources are linted by kotoba.lang.cljk-lint (jvm/cljk_lint.cljk,
;; vendored from kotoba-lang/kotoba-lang), which hands each file to clj-kondo
;; in the language cljk-origin.edn records for it. This config is
;; kotoba-lang/kotoba-lang's .clj-kondo/config.edn kotoba.test block (523e0f9).
;;
;; kotoba.test is clojure.test's surface forwarded to the host runner
;; (kotoba-lang/test src/kotoba/test.cljk: each macro expands to the host macro
;; of the same name with the same arguments). clj-kondo does not expand it, so
;; without this every deftest name and every `thrown?` / `thrown-with-msg?`
;; is reported as an unresolved symbol. `lint-as` gives the macros
;; clojure.test's shapes; `thrown?` / `thrown-with-msg?` are special only
;; inside clojure.test/is itself, so they are excluded inside kotoba.test/is
;; by name.
{:lint-as {kotoba.test/deftest clojure.test/deftest
           kotoba.test/is clojure.test/is
           kotoba.test/are clojure.test/are
           kotoba.test/testing clojure.test/testing
           kotoba.test/use-fixtures clojure.test/use-fixtures
           kotoba.test/async cljs.test/async}
 :linters {:unresolved-symbol
           {:exclude [(kotoba.test/is [thrown? thrown-with-msg?])]}}}
